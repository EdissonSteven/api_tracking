# Application Configuration
APP_NAME=Tracking API
APP_VERSION=1.0.0
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Database Configuration
DATABASE_URL=postgresql://trackinguser:trackingpass@localhost:5432/tracking_db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# Security Configuration
SECRET_KEY=your-super-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
ALLOWED_ORIGINS=["https://tracking.company.com","https://admin.company.com"]

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring Configuration
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Business Rules
MAX_CHECKPOINTS_PER_UNIT=50
TRACKING_TTL_DAYS=90